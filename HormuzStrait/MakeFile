CC = gcc
CFLAGS = -Wall -g -Iinclude
RM = rm -f

TARGET = HormuzTankers.exe

SRC_DIR = src
INC_DIR = include
BUILD_DIR = build

SRCS = $(SRC_DIR)/main.c \
       $(SRC_DIR)/count_mark.c \
       $(SRC_DIR)/pic_preprocessing.c \
       $(SRC_DIR)/png_interaction.c \
       $(SRC_DIR)/rgba_grayscale.c \
       $(SRC_DIR)/lodepng.c

OBJS = $(SRCS:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)

all: $(BUILD_DIR) $(TARGET)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(TARGET): $(OBJS)
	$(CC) $(OBJS) $(CFLAGS) -o $(TARGET)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	$(RM) -r $(BUILD_DIR) $(TARGET)